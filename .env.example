# Cliente (estas dos variables se incorporan al bundle y no son secretos)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Servidor (no usar prefijo VITE_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-5-mini

# Mercado Pago y entrega automática. Todas son variables privadas del servidor.
MERCADOPAGO_ACCESS_TOKEN=TEST-xxx
MERCADOPAGO_WEBHOOK_URL=https://hook.us2.make.com/xxx
# Recomendado antes de producción: clave secreta generada en Mercado Pago > Webhooks.
MERCADOPAGO_WEBHOOK_SECRET=xxx
